# Local virtualenv — recreate via:
#   python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
# (Too large to track: ~68 MB on aarch64.)
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Claude Code session state
.claude/

# Editor / OS noise
*.swp
.DS_Store

# Local timestamped backups produced when editing config in place
*.before-*
*.bak-*

# Local secrets: API keys + gateway token. Keep this file out of the repo.
# Copy resources/voice-bridge.secrets.example.json → voice-bridge.secrets.json and fill in.
voice-bridge.secrets.json

# Local provider-swap config variants (e.g. voice-bridge.json.deepgram): a saved
# copy of voice-bridge.json to swap in. Personal working files that drift from
# the tracked config — keep them out of the repo.
voice-bridge.json.*
